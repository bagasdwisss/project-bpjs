# Vercel & Vite API Configuration
# Di Vercel atau production, /api akan diarahkan otomatis ke Serverless Functions
VITE_API_URL=/api
VITE_API_BASE_URL=
VITE_APP_NAME="Sistem Absensi & Nilai BPJS"

# Neon PostgreSQL Database Connection URL
# Dapatkan connection string gratis dari: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret untuk Autentikasi
JWT_SECRET=bpjs-super-secret-key-2026-vercel-neon