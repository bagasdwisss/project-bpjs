# Vercel & Vite API Configuration
VITE_API_URL=/api
VITE_API_BASE_URL=
VITE_APP_NAME="Sistem Absensi & Nilai BPJS"

# Neon PostgreSQL Database Connection URL
# Buat akun gratis di https://console.neon.tech -> Buat Database -> Salin Connection String (Pooled)
DATABASE_URL=postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require

# JWT Secret untuk Autentikasi
JWT_SECRET=bpjs-super-secret-key-2026-vercel-neon
